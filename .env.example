# ---------------------------------------------------------------------------
# Supabase (database + auth + shared proposal links)
# Server-side
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (exposed to the browser — publishable values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# AI provider (proposal generation, section regeneration, summaries)
#
# Option A — Google AI Studio (Gemini). Just set the key; base URL, request
# style and model default automatically.
GOOGLE_AI_API_KEY=
# AI_MODEL=gemini-2.5-flash
#
# Option B — any OpenAI-compatible "/v1/responses" endpoint.
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-5.6-sol
#
# Force the request shape when auto-detection is wrong: "chat" or "responses".
# AI_API_STYLE=chat

# ---------------------------------------------------------------------------
# Public site URL, used for canonical/OG metadata and share links.
VITE_APP_URL=http://localhost:8080

# Build target for nitro (node-server | vercel | netlify | cloudflare-module ...)
# NITRO_PRESET=node-server
